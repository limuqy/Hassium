# Two concurrent clients, deterministic high-volume workload; phase durations supplied to every JVM.
join label=WAIT_JOIN_1 since=start timeoutMs=${joinTimeoutMs}
wait ms=${egressStressWaitMs}
assertProbe key=egress.fixtureReceived op=eq value=${egressStressExpected}
dump label=ROUND1 round=1
exit rounds=1
