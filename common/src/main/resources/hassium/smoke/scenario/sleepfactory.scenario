# Native 1.21.1 ZIP copy only; never downgrade to 1.20.1.
join label=SLEEP_FACTORY_JOIN since=start timeoutMs=${joinTimeoutMs} requirePositiveY=false
wait ms=3000
command text="gamerule sendCommandFeedback false"
command text="gamemode spectator"
command text="tp @s 72.5 78 79.5 0 10"
command text="gamemode creative"
input mode=hover ms=45000
# One unbreakable input target in the disposable test copy, below the AFK position.
command text="setblock 72 77 79 bedrock"
command text="gamemode survival"
command text="effect give @s resistance 1200 4 true"
command text="tp @s 72.5 78 79.5 0 90"
command text="tick rate 20"
command text="tick unfreeze"
wait ms=5000
dump label=ROUND1 round=1 world=true
command text="tag @s add sleep_traffic_idle_normal"
wait ms=250
input mode=idle ms=30000 targetX=72 targetY=77 targetZ=79
command text="tag @s remove sleep_traffic_idle_normal"
command text="tag @s add sleep_traffic_idle_entry"
wait ms=250
sleep action=enter threshold=6
command text="tag @s remove sleep_traffic_idle_entry"
command text="tag @s add sleep_traffic_idle_sleep"
wait ms=250
input mode=idle ms=30000 targetX=72 targetY=77 targetZ=79
command text="tag @s remove sleep_traffic_idle_sleep"
command text="tag @s add sleep_traffic_idle_recovery"
wait ms=250
sleep action=wake offlineMs=5000
wait ms=10000
command text="tag @s remove sleep_traffic_idle_recovery"
command text="tag @s add sleep_traffic_hold_attack_normal"
wait ms=250
input mode=hold_attack ms=30000 targetX=72 targetY=77 targetZ=79
command text="tag @s remove sleep_traffic_hold_attack_normal"
command text="tag @s add sleep_traffic_hold_attack_entry"
wait ms=250
sleep action=enter threshold=6
command text="tag @s remove sleep_traffic_hold_attack_entry"
command text="tag @s add sleep_traffic_hold_attack_sleep"
wait ms=250
input mode=hold_attack ms=30000 targetX=72 targetY=77 targetZ=79
command text="tag @s remove sleep_traffic_hold_attack_sleep"
command text="tag @s add sleep_traffic_hold_attack_recovery"
wait ms=250
sleep action=wake offlineMs=5000
wait ms=10000
command text="tag @s remove sleep_traffic_hold_attack_recovery"
command text="tag @s add sleep_traffic_periodic_attack_normal"
wait ms=250
input mode=periodic_attack ms=30000 targetX=72 targetY=77 targetZ=79
command text="tag @s remove sleep_traffic_periodic_attack_normal"
command text="tag @s add sleep_traffic_periodic_attack_entry"
wait ms=250
sleep action=enter threshold=6
command text="tag @s remove sleep_traffic_periodic_attack_entry"
command text="tag @s add sleep_traffic_periodic_attack_sleep"
wait ms=250
input mode=periodic_attack ms=30000 targetX=72 targetY=77 targetZ=79
command text="tag @s remove sleep_traffic_periodic_attack_sleep"
command text="tag @s add sleep_traffic_periodic_attack_recovery"
wait ms=250
sleep action=wake offlineMs=5000
wait ms=10000
command text="tag @s remove sleep_traffic_periodic_attack_recovery"
command text="tag @s add sleep_traffic_done"
wait ms=250
wait ms=2000
dump label=ROUND2 round=2 world=true
exit rounds=2
