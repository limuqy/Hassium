join label=EXPIRY_JOIN since=start timeoutMs=120000
wait ms=15000
command text="gamemode creative"
command text="fill -12 139 -12 12 139 12 stone"
command text="tp @s 0.5 140 0.5 0 0"
command text="setblock 2 140 4 hopper"
wait ms=15000
dump label=ROUND1 round=1 world=true
sleep action=enter threshold=6 ui=true
sleep action=expire
wait ms=5000
sleep action=manual
reconnect delayMs=1000 sleep=true
join label=FAILURE_MANUAL since=disconnect timeoutMs=120000
wait ms=5000
command text="tag @s add sleep_probe_fail_recovery"
wait ms=500
sleep action=enter threshold=6
sleep action=wake_failure
wait ms=12000
exit rounds=1
