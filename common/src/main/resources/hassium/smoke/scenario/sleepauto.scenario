join label=SLEEP_AUTO_JOIN since=start timeoutMs=120000
wait ms=15000
command text="gamemode creative"
command text="tp @s 0.5 140 0.5 0 90"
command text="gamerule doMobSpawning false"
command text="fill -12 139 -12 12 139 12 bedrock"
command text="setblock 2 140 4 hopper"
command text="setblock 48 140 4 hopper"
command text="gamemode survival"
wait ms=20000
dump label=ROUND1 round=1 world=true
sleep action=auto_menu
sleep action=auto releaseDuringEntry=true
sleep action=capture
sleep action=release
sleep action=wake
wait ms=15000
dump label=ROUND2 round=2 world=true
exit rounds=2
