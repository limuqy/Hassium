command text="tp @s 30.5 140 5.5 0 20"
command text="gamemode survival"
wait ms=45000
command text="tag @s add traffic_factory_r1"
input mode=idle ms=60000
command text="tag @s remove traffic_factory_r1"
wait ms=2000
command text="tag @s add traffic_factory_r2"
input mode=idle ms=60000
command text="tag @s remove traffic_factory_r2"
wait ms=2000
command text="tag @s add traffic_factory_r3"
input mode=idle ms=60000
command text="tag @s remove traffic_factory_r3"
