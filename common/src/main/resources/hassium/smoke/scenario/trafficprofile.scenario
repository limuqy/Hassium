wait ms=10000
command text="tag @s add traffic_factory_hold"
input mode=hold_attack ms=60000
command text="tag @s remove traffic_factory_hold"
wait ms=2000
command text="tag @s add traffic_factory_periodic"
input mode=periodic_attack ms=60000
command text="tag @s remove traffic_factory_periodic"
wait ms=2000
command text="tag @s add traffic_done"
assertProbe key=joined op=eq value=true
dump label=ROUND1 round=1
exit rounds=1
