# twilightforest 场景：自定义维度缓存冒烟（Fabric / NeoForge 通用）。
# 维度 id：twilightforest:twilight_forest
# 依赖：对应加载器 jar 放入 run/{client,server}/mods。
# contentCheck 可选：TF 有地形；若出生在树冠/空中 3×3 可能采样不足，不作硬门禁。
join label=WAIT_JOIN_1 since=start timeoutMs=${joinTimeoutMs}
wait ms=${round1WaitMs}
dimension to=twilightforest:twilight_forest
wait ms=45000
dump label=TF_R1 round=1
assertProbe label=T1_JOINED key=joined op=eq value=true
assertProbe label=T1_DIM key=dimension op=eq value=twilightforest:twilight_forest
assertProbe label=T1_APPLIED key=stats.clientAppliedChunkCount op=gt value=16
assertProbe label=T1_LOADED key=clientCache.loadedChunks op=gt value=16
disconnect
reconnect delayMs=${reconnectDelayMs}
join label=WAIT_JOIN_2 since=disconnect timeoutMs=${joinTimeoutMs}
wait ms=${round2WaitMs}
dimension to=twilightforest:twilight_forest
wait ms=25000
dump label=TF_R2 round=2 gate=false
assertProbe label=T2_JOINED key=joined op=eq value=true
assertProbe label=T2_DIM key=dimension op=eq value=twilightforest:twilight_forest
assertProbe label=T2_APPLIED key=stats.clientAppliedChunkCount op=gt value=16
assertProbe label=T2_CACHED key=stats.cacheHitFullChunkCount op=gt value=0
exit rounds=1
